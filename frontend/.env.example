# Browser-exposed only. Never put JWT keys, DB passwords, or filesystem paths in VITE_* vars.
# Copy to frontend/.env and/or frontend/.env.local for local overrides (gitignored).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Client-side product image UX limits — keep aligned with repo-root PRODUCT_IMAGE_*.
# Backend PRODUCT_IMAGE_MAX_SIZE_BYTES remains authoritative (strict size < max).
VITE_PRODUCT_IMAGE_MAX_SIZE_BYTES=2097152
VITE_PRODUCT_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Local-demo-only credentials for scripts/import-foodmart-demo.mjs (not used by the Vite app).
# Must match the seeded Admin password in your running API (see docs/DEMO_SEED.md / repo-root .env).
# Explicit shell exports always override these values. Never commit real secrets.
DEMO_ADMIN_EMAIL=admin@aptech4.local
DEMO_ADMIN_PASSWORD=admin
API_BASE_URL=http://localhost:8088/api/v1
