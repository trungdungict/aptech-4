# Aptech-4 environment template — copy to `.env` and adjust.
# NEVER commit a real `.env` with production secrets.

# --- Compose / Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aptech4
POSTGRES_USER=aptech
POSTGRES_PASSWORD=aptech_dev_change_me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_ISSUER=aptech4-api
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!
# Access and refresh secrets MUST differ and each MUST be >= 32 characters (HS256).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8088,http://127.0.0.1:8088
# Do not set CORS_ALLOWED_ORIGINS=* while using credentialed browser clients.


# --- OpenAPI / Swagger (disable on public EC2 unless required) ---
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
# Or use SPRING_PROFILES_ACTIVE=prod to disable both via application-prod.yml


# --- Demo seed accounts (local/demo only; make seed-demo / make up-all) ---
# Never use in production. Seed is OFF unless APTECH_SEED_ENABLED=true (Makefile sets this).
# Local-demo-only short passwords (≥5 for seed; public /register remains ≥8).
# APTECH_SEED_ENABLED=false
DEMO_ADMIN_EMAIL=admin@aptech4.local
DEMO_ADMIN_PASSWORD=admin
DEMO_CUSTOMER_EMAIL=customer@aptech4.local
DEMO_CUSTOMER_PASSWORD=customer

# --- Local AI / Ollama (ADR-019). Off for bare `make deploy-local`. ---
# `make up-all` / `make deploy-demo-stack` force-enable against Compose service `ollama`.
# APTECH_AI_ENABLED=false
# SPRING_AI_MODEL_CHAT=none
# OLLAMA_BASE_URL=http://localhost:11434
APTECH_AI_MODEL=llama3.2
# APTECH_AI_TIMEOUT_SECONDS=90
# APTECH_AI_LOW_STOCK_THRESHOLD=5
# First `make up-all` pulls the model into volume aptech4_ollama (can be several GB).

# --- React (Vite) — build/dev time only (baked into the bundle; not runtime-mutable) ---
# Host Vite → local Spring: absolute URL below.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Compose profile `stack` web image build arg (same-origin via nginx). Do not put localhost here.
# VITE_STACK_API_BASE_URL=/api/v1

# --- Local Compose stack (make deploy-local) ---
# WEB_PORT=8088
# Optional direct API publish (loopback only). Change if host :8080 is busy.
# API_PUBLISH=127.0.0.1:8080
# For stack CORS when browsing http://localhost:8088 (same-origin usually skips CORS):
# CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://localhost:3000

# --- Monitoring (Compose profile monitoring; included in make up-all) ---
# Loopback-only UIs. Never commit real Grafana passwords to git.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aptech_grafana_change_me
GRAFANA_ROOT_URL=http://127.0.0.1:3001
# See docs/MONITORING.md (cAdvisor mounts docker.sock — local only).

# --- Flutter build-time only (Makefile / scripts → --dart-define) ---
# The running app does NOT read this OS env at runtime; it is compiled in.
# Emulator → host API:  http://10.0.2.2:8080/api/v1
# Physical device:      http://<YOUR_LAN_IP>:8080/api/v1  (do not commit a real LAN IP)
# Production:           https://<public-host>/api/v1
# Note: localhost inside emulator/device ≠ your Mac. See mobile/README.md + ADR-014.
API_BASE_URL=http://10.0.2.2:8080/api/v1
# Pinned Flutter for mobile Docker image tag (must match Shorebird-supported stable)
FLUTTER_VERSION=3.47.8
# Shorebird Cloud API key (Account → API Keys at console.shorebird.dev).
# Used by: make mobile-shorebird-init|release|patch and docker-compose.mobile.yml
# Never commit a real token. Local value lives only in gitignored `.env`.
SHOREBIRD_TOKEN=replace_with_your_shorebird_api_key

# --- EC2 (optional; required only for remote Make targets) ---
# EC2_HOST=
# EC2_USER=ubuntu
# SSH_KEY=~/.ssh/id_ed25519
# EC2_SSH_PORT=22
