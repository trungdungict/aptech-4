frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/.env
frontend/.env.*
frontend/.env.local

*.md
!frontend/README.md
!deploy/README.md

**/target/
**/*.log
**/coverage/
